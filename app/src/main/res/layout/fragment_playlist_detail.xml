<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_primary"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/playlist_detail_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/playlist_detail_collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@color/surface_primary"
            app:statusBarScrim="@color/surface_primary"
            app:titleEnabled="false"
            app:expandedTitleGravity="start|bottom"
            app:collapsedTitleGravity="start"
            app:expandedTitleMarginStart="@dimen/margin_screen_edge"
            app:expandedTitleMarginEnd="@dimen/margin_screen_edge"
            app:expandedTitleMarginBottom="@dimen/spacing_lg">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/margin_screen_edge"
                android:fitsSystemWindows="true"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.5">

                <ImageView
                    android:id="@+id/iv_playlist_detail_cover"
                    android:layout_width="@dimen/album_art_size_xlarge"
                    android:layout_height="@dimen/album_art_size_xlarge"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/desc_playlist_cover"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/v_playlist_cover_gradient"
                    android:layout_width="@dimen/album_art_size_xlarge"
                    android:layout_height="@dimen/album_art_size_xlarge"
                    android:background="@drawable/gradient_overlay_album_art"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="@id/iv_playlist_detail_cover"
                    app:layout_constraintTop_toTopOf="@id/iv_playlist_detail_cover"
                    app:layout_constraintBottom_toBottomOf="@id/iv_playlist_detail_cover"
                    app:layout_constraintEnd_toEndOf="@id/iv_playlist_detail_cover" />

                <TextView
                    android:id="@+id/tv_playlist_detail_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.EqnityMusic.HeadlineMedium"
                    android:textColor="@color/text_primary"
                    app:layout_constraintStart_toEndOf="@id/iv_playlist_detail_cover"
                    app:layout_constraintTop_toTopOf="@id/iv_playlist_detail_cover"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="@dimen/spacing_md" />

                <TextView
                    android:id="@+id/tv_playlist_detail_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.EqnityMusic.BodyMedium"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintStart_toStartOf="@id/tv_playlist_detail_name"
                    app:layout_constraintTop_toBottomOf="@id/tv_playlist_detail_name"
                    app:layout_constraintEnd_toEndOf="@id/tv_playlist_detail_name"
                    android:layout_marginTop="@dimen/spacing_xs" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_playlist_play"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:text="@string/menu_play"
                    android:icon="@drawable/ic_play"
                    app:iconGravity="start"
                    app:iconPadding="@dimen/spacing_xs"
                    app:layout_constraintStart_toStartOf="@id/tv_playlist_detail_name"
                    app:layout_constraintTop_toBottomOf="@id/tv_playlist_detail_info"
                    android:layout_marginTop="@dimen/spacing_md"
                    style="@style/Widget.EqnityMusic.Button" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:title=""
                app:navigationIcon="@drawable/ic_close"
                app:menu="@menu/playlist_detail_toolbar_menu" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/player_height_collapsed"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_screen_edge">

            <TextView
                android:id="@+id/section_songs_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/downloaded_music"
                android:textAppearance="@style/TextAppearance.EqnityMusic.TitleLarge"
                android:textColor="@color/text_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_playlist_songs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingTop="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_xxl"
                app:layout_constraintTop_toBottomOf="@id/section_songs_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Empty State -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/empty_state_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone"
                android:padding="@dimen/spacing_xxl"
                app:layout_constraintTop_toBottomOf="@id/section_songs_title"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/empty_state_icon"
                    android:layout_width="@dimen/avatar_size_xxl"
                    android:layout_height="@dimen/avatar_size_xxl"
                    android:src="@drawable/ic_music_note"
                    android:tint="@color/text_tertiary"
                    android:contentDescription="@string/desc_album_art"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/empty_state_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/playlist_songs_empty"
                    android:textAppearance="@style/TextAppearance.EqnityMusic.TitleLarge"
                    android:textColor="@color/text_primary"
                    app:layout_constraintTop_toBottomOf="@id/empty_state_icon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="@dimen/spacing_lg" />

                <TextView
                    android:id="@+id/empty_state_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/playlist_songs_empty_subtitle"
                    android:textAppearance="@style/TextAppearance.EqnityMusic.BodyMedium"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/empty_state_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="@dimen/spacing_xs" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_songs"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:text="@string/playlist_add_songs"
                    android:icon="@drawable/ic_add"
                    app:iconGravity="start"
                    app:iconPadding="@dimen/spacing_xs"
                    app:layout_constraintTop_toBottomOf="@id/empty_state_subtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="@dimen/spacing_lg"
                    style="@style/Widget.EqnityMusic.Button" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>