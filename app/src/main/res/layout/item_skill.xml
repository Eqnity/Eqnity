<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_rounded"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivSkillIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/support_section_skills"
        android:src="@drawable/ic_code"
        android:tint="@color/accent_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSkillTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.EqnityMusic.TitleSmall"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvSkillDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.EqnityMusic.BodySmall"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvSkillTech"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.EqnityMusic.BodySmall"
            android:textColor="@color/accent_primary" />

    </LinearLayout>

</LinearLayout>