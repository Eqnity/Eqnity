<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    app:cardCornerRadius="@dimen/card_corner_radius_small"
    app:cardBackgroundColor="@color/surface_secondary"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline_variant"
    app:strokeWidth="1dp"
    style="@style/Widget.EqnityMusic.PlaylistItem">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_md">

        <!-- Playlist Cover -->
        <ImageView
            android:id="@+id/iv_playlist_cover"
            android:layout_width="@dimen/album_art_size_large"
            android:layout_height="@dimen/album_art_size_large"
            android:scaleType="centerCrop"
            android:contentDescription="@string/desc_playlist_cover"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Playlist Info -->
        <TextView
            android:id="@+id/tv_playlist_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.EqnityMusic.TitleMedium"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toEndOf="@id/iv_playlist_cover"
            app:layout_constraintTop_toTopOf="@id/iv_playlist_cover"
            app:layout_constraintEnd_toStartOf="@id/btn_playlist_more"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_sm" />

        <TextView
            android:id="@+id/tv_playlist_song_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.EqnityMusic.BodySmall"
            android:textColor="@color/text_secondary"
            app:layout_constraintStart_toStartOf="@id/tv_playlist_name"
            app:layout_constraintTop_toBottomOf="@id/tv_playlist_name"
            app:layout_constraintEnd_toEndOf="@id/tv_playlist_name"
            android:layout_marginTop="@dimen/spacing_xxs" />

        <TextView
            android:id="@+id/tv_playlist_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.EqnityMusic.BodySmall"
            android:textColor="@color/text_tertiary"
            app:layout_constraintStart_toStartOf="@id/tv_playlist_name"
            app:layout_constraintBottom_toBottomOf="@id/iv_playlist_cover" />

        <!-- More Options -->
        <ImageButton
            android:id="@+id/btn_playlist_more"
            android:layout_width="@dimen/icon_size_lg"
            android:layout_height="@dimen/icon_size_lg"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="@string/desc_more_options"
            android:tint="@color/text_tertiary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_playlist_cover"
            app:layout_constraintBottom_toBottomOf="@id/iv_playlist_cover" />

        <!-- Play Button Overlay -->
        <ImageButton
            android:id="@+id/btn_playlist_play"
            android:layout_width="@dimen/icon_size_lg"
            android:layout_height="@dimen/icon_size_lg"
            android:background="@drawable/btn_player_control_background"
            android:src="@drawable/ic_play"
            android:contentDescription="@string/menu_play"
            android:tint="@color/text_primary"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/iv_playlist_cover"
            app:layout_constraintEnd_toEndOf="@id/iv_playlist_cover"
            app:layout_constraintTop_toTopOf="@id/iv_playlist_cover"
            app:layout_constraintBottom_toBottomOf="@id/iv_playlist_cover" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>