<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/dialog_padding"
    android:maxHeight="500dp">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_to_playlist_title"
        android:textAppearance="@style/TextAppearance.EqnityMusic.TitleLarge"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_dialog_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/add_to_playlist_select"
        android:textAppearance="@style/TextAppearance.EqnityMusic.BodyMedium"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tv_dialog_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_md" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_playlist_options"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tv_dialog_message"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_create_new_playlist"
        android:layout_marginTop="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_md" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_create_new_playlist"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:text="@string/add_to_playlist_create_new"
        android:icon="@drawable/ic_add"
        app:iconGravity="start"
        app:iconPadding="@dimen/spacing_xs"
        app:layout_constraintTop_toBottomOf="@id/rv_playlist_options"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_md"
        style="@style/Widget.EqnityMusic.Button.Outlined" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/btn_create_new_playlist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:text="@string/download_dialog_cancel"
            android:layout_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_dialog_add"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="@dimen/spacing_sm"
            style="@style/Widget.EqnityMusic.Button.Outlined" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_add"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:text="@string/menu_add_to_playlist"
            android:layout_weight="1"
            app:layout_constraintStart_toEndOf="@id/btn_dialog_cancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="@dimen/spacing_sm"
            style="@style/Widget.EqnityMusic.Button" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>