<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    app:cardCornerRadius="@dimen/card_corner_radius_small"
    app:cardBackgroundColor="@color/surface_secondary"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline_variant"
    app:strokeWidth="1dp"
    style="@style/Widget.EqnityMusic.DownloadItem">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_md">

        <!-- Album Art -->
        <ImageView
            android:id="@+id/iv_music_art"
            android:layout_width="@dimen/album_art_size_medium"
            android:layout_height="@dimen/album_art_size_medium"
            android:scaleType="centerCrop"
            android:contentDescription="@string/desc_album_art"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Gradient Overlay on Album Art -->
        <View
            android:id="@+id/v_music_art_gradient"
            android:layout_width="@dimen/album_art_size_medium"
            android:layout_height="@dimen/album_art_size_medium"
            android:background="@drawable/gradient_overlay_album_art"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/iv_music_art"
            app:layout_constraintTop_toTopOf="@id/iv_music_art"
            app:layout_constraintBottom_toBottomOf="@id/iv_music_art"
            app:layout_constraintEnd_toEndOf="@id/iv_music_art" />

        <!-- Title & Artist -->
        <TextView
            android:id="@+id/tv_music_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.EqnityMusic.TitleMedium"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toEndOf="@id/iv_music_art"
            app:layout_constraintTop_toTopOf="@id/iv_music_art"
            app:layout_constraintEnd_toStartOf="@id/btn_music_more"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_sm" />

        <TextView
            android:id="@+id/tv_music_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.EqnityMusic.BodySmall"
            android:textColor="@color/text_secondary"
            app:layout_constraintStart_toStartOf="@id/tv_music_title"
            app:layout_constraintTop_toBottomOf="@id/tv_music_title"
            app:layout_constraintEnd_toEndOf="@id/tv_music_title"
            android:layout_marginTop="@dimen/spacing_xxs" />

        <!-- Duration & Source -->
        <TextView
            android:id="@+id/tv_music_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.EqnityMusic.BodySmall"
            android:textColor="@color/text_tertiary"
            app:layout_constraintStart_toStartOf="@id/tv_music_title"
            app:layout_constraintBottom_toBottomOf="@id/iv_music_art" />

        <TextView
            android:id="@+id/tv_music_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.EqnityMusic.LabelSmall"
            android:textColor="@color/accent_primary"
            android:background="@color/accent_primary_container"
            android:paddingHorizontal="@dimen/spacing_xs"
            android:paddingVertical="@dimen/spacing_xxxs"
            android:textAllCaps="true"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/tv_music_duration"
            app:layout_constraintBottom_toBottomOf="@id/tv_music_duration"
            android:layout_marginStart="@dimen/spacing_sm" />

        <!-- More Options Button -->
        <ImageButton
            android:id="@+id/btn_music_more"
            android:layout_width="@dimen/icon_size_lg"
            android:layout_height="@dimen/icon_size_lg"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="@string/desc_more_options"
            android:tint="@color/text_tertiary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_music_art"
            app:layout_constraintBottom_toBottomOf="@id/iv_music_art" />

        <!-- Play Indicator -->
        <ImageView
            android:id="@+id/iv_music_playing_indicator"
            android:layout_width="@dimen/icon_size_sm"
            android:layout_height="@dimen/icon_size_sm"
            android:src="@drawable/ic_equalizer"
            android:tint="@color/accent_primary"
            android:visibility="gone"
            android:contentDescription="@string/desc_play_pause"
            app:layout_constraintStart_toStartOf="@id/iv_music_art"
            app:layout_constraintEnd_toEndOf="@id/iv_music_art"
            app:layout_constraintTop_toTopOf="@id/iv_music_art"
            app:layout_constraintBottom_toBottomOf="@id/iv_music_art" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>