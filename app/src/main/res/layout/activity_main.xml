<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_primary"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface_primary"
            app:title="@string/app_name"
            app:titleTextAppearance="@style/TextAppearance.EqnityMusic.TitleLarge"
            app:navigationIcon="@drawable/ic_menu"
            app:menu="@menu/main_toolbar_menu"
            app:contentInsetStart="16dp"
            app:contentInsetEnd="16dp" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="@dimen/bottom_nav_height" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="@color/tab_background"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="@dimen/bottom_nav_icon_size"
        app:itemTextAppearanceActive="@style/TextAppearance.EqnityMusic.LabelSmall"
        app:itemTextAppearanceInactive="@style/TextAppearance.EqnityMusic.LabelSmall"
        app:itemIconTint="@color/bottom_nav_item_tint"
        app:itemTextColor="@color/bottom_nav_item_tint"
        app:itemRippleColor="@color/accent_primary_container" />

    <!-- Mini Player - Collapsed -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mini_player"
        android:layout_width="match_parent"
        android:layout_height="@dimen/player_height_collapsed"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/margin_screen_edge"
        android:layout_marginBottom="@dimen/bottom_nav_height"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/card_corner_radius_small"
        app:cardElevation="@dimen/card_elevation_raised"
        app:cardBackgroundColor="@color/surface_secondary"
        app:strokeColor="@color/outline_variant"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/spacing_md">

            <ImageView
                android:id="@+id/mini_player_art"
                android:layout_width="@dimen/player_art_size"
                android:layout_height="@dimen/player_art_size"
                android:scaleType="centerCrop"
                android:contentDescription="@string/desc_album_art"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <View
                android:id="@+id/mini_player_gradient_overlay"
                android:layout_width="@dimen/player_art_size"
                android:layout_height="@dimen/player_art_size"
                android:background="@drawable/gradient_overlay_album_art"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/mini_player_art"
                app:layout_constraintTop_toTopOf="@id/mini_player_art"
                app:layout_constraintBottom_toBottomOf="@id/mini_player_art"
                app:layout_constraintEnd_toEndOf="@id/mini_player_art" />

            <TextView
                android:id="@+id/mini_player_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.EqnityMusic.BodyMedium"
                android:textColor="@color/text_primary"
                app:layout_constraintStart_toEndOf="@id/mini_player_art"
                app:layout_constraintTop_toTopOf="@id/mini_player_art"
                app:layout_constraintEnd_toStartOf="@id/mini_player_play_pause"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md" />

            <TextView
                android:id="@+id/mini_player_artist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.EqnityMusic.BodySmall"
                android:textColor="@color/text_secondary"
                app:layout_constraintStart_toStartOf="@id/mini_player_title"
                app:layout_constraintTop_toBottomOf="@id/mini_player_title"
                app:layout_constraintEnd_toEndOf="@id/mini_player_title"
                android:layout_marginTop="@dimen/spacing_xxs" />

            <ImageButton
                android:id="@+id/mini_player_play_pause"
                android:layout_width="@dimen/player_control_button_size"
                android:layout_height="@dimen/player_control_button_size"
                android:background="@drawable/btn_player_control_background"
                android:src="@drawable/ic_play"
                android:contentDescription="@string/desc_play_pause"
                android:tint="@color/text_primary"
                app:layout_constraintEnd_toStartOf="@id/mini_player_next"
                app:layout_constraintTop_toTopOf="@id/mini_player_art"
                app:layout_constraintBottom_toBottomOf="@id/mini_player_art"
                android:layout_marginEnd="@dimen/spacing_sm" />

            <ImageButton
                android:id="@+id/mini_player_next"
                android:layout_width="@dimen/player_control_button_size"
                android:layout_height="@dimen/player_control_button_size"
                android:background="@drawable/btn_player_control_background"
                android:src="@drawable/ic_skip_next"
                android:contentDescription="@string/desc_next"
                android:tint="@color/text_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/mini_player_art"
                app:layout_constraintBottom_toBottomOf="@id/mini_player_art" />

            <ImageView
                android:id="@+id/mini_player_drag_handle"
                android:layout_width="@dimen/player_handle_width"
                android:layout_height="@dimen/player_handle_height"
                android:src="@drawable/ic_drag_handle"
                android:contentDescription="@string/desc_drag_handle"
                android:tint="@color/player_handle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginEnd="@dimen/spacing_md" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Full Screen Player Container (initially hidden) -->
    <FrameLayout
        android:id="@+id/full_player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/player_background" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>