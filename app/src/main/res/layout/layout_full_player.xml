<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_background"
    android:fitsSystemWindows="true">

    <!-- Background with Dynamic Gradient from Album Art -->
    <ImageView
        android:id="@+id/iv_full_player_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/desc_album_art" />

    <View
        android:id="@+id/v_full_player_gradient_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_full_player_overlay" />

    <!-- Drag Handle -->
    <ImageView
        android:id="@+id/iv_full_player_drag_handle"
        android:layout_width="@dimen/player_handle_width"
        android:layout_height="@dimen/player_handle_height"
        android:src="@drawable/ic_drag_handle"
        android:contentDescription="@string/desc_drag_handle"
        android:tint="@color/player_handle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_md" />

    <!-- Album Art -->
    <ImageView
        android:id="@+id/iv_full_player_art"
        android:layout_width="@dimen/player_art_size_expanded"
        android:layout_height="@dimen/player_art_size_expanded"
        android:scaleType="centerCrop"
        android:contentDescription="@string/desc_album_art"
        app:layout_constraintTop_toBottomOf="@id/iv_full_player_drag_handle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_xl" />

    <!-- Title & Artist -->
    <TextView
        android:id="@+id/tv_full_player_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.EqnityMusic.HeadlineMedium"
        android:textColor="@color/text_primary"
        android:paddingHorizontal="@dimen/margin_screen_edge"
        app:layout_constraintTop_toBottomOf="@id/iv_full_player_art"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_lg" />

    <TextView
        android:id="@+id/tv_full_player_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.EqnityMusic.BodyLarge"
        android:textColor="@color/text_secondary"
        android:paddingHorizontal="@dimen/margin_screen_edge"
        app:layout_constraintTop_toBottomOf="@id/tv_full_player_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_xs" />

    <!-- Progress Bar -->
    <com.google.android.material.slider.Slider
        android:id="@+id/slider_full_player_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:stepSize="1"
        android:paddingHorizontal="@dimen/margin_screen_edge"
        android:paddingVertical="@dimen/spacing_md"
        app:trackColor="@color/progress_inactive"
        app:trackColorActive="@color/progress_active"
        app:thumbColor="@color/accent_primary"
        app:haloColor="@color/accent_primary_container"
        app:trackHeight="@dimen/progress_thickness"
        app:thumbRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_full_player_artist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_md" />

    <!-- Time Labels -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margin_screen_edge"
        app:layout_constraintTop_toBottomOf="@id/slider_full_player_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_full_player_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textAppearance="@style/TextAppearance.EqnityMusic.BodySmall"
            android:textColor="@color/text_tertiary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_full_player_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textAppearance="@style/TextAppearance.EqnityMusic.BodySmall"
            android:textColor="@color/text_tertiary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Player Controls -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margin_screen_edge"
        android:paddingVertical="@dimen/spacing_lg"
        app:layout_constraintTop_toBottomOf="@id/slider_full_player_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btn_full_player_shuffle"
            android:layout_width="@dimen/player_control_button_size"
            android:layout_height="@dimen/player_control_button_size"
            android:background="@drawable/btn_player_control_background"
            android:src="@drawable/ic_shuffle"
            android:contentDescription="@string/desc_shuffle"
            android:tint="@color/text_secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/btn_full_player_previous"
            android:layout_width="@dimen/player_control_button_size"
            android:layout_height="@dimen/player_control_button_size"
            android:background="@drawable/btn_player_control_background"
            android:src="@drawable/ic_skip_previous"
            android:contentDescription="@string/desc_previous"
            android:tint="@color/text_primary"
            app:layout_constraintStart_toEndOf="@id/btn_full_player_shuffle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/spacing_xl" />

        <ImageButton
            android:id="@+id/btn_full_player_play_pause"
            android:layout_width="@dimen/player_play_button_size"
            android:layout_height="@dimen/player_play_button_size"
            android:background="@drawable/btn_play_pause_background"
            android:src="@drawable/ic_pause"
            android:contentDescription="@string/desc_play_pause"
            android:tint="@color/text_on_accent"
            app:layout_constraintStart_toEndOf="@id/btn_full_player_previous"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/spacing_xl" />

        <ImageButton
            android:id="@+id/btn_full_player_next"
            android:layout_width="@dimen/player_control_button_size"
            android:layout_height="@dimen/player_control_button_size"
            android:background="@drawable/btn_player_control_background"
            android:src="@drawable/ic_skip_next"
            android:contentDescription="@string/desc_next"
            android:tint="@color/text_primary"
            app:layout_constraintStart_toEndOf="@id/btn_full_player_play_pause"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/spacing_xl" />

        <ImageButton
            android:id="@+id/btn_full_player_loop"
            android:layout_width="@dimen/player_control_button_size"
            android:layout_height="@dimen/player_control_button_size"
            android:background="@drawable/btn_player_control_background"
            android:src="@drawable/ic_loop"
            android:contentDescription="@string/desc_loop"
            android:tint="@color/text_secondary"
            app:layout_constraintStart_toEndOf="@id/btn_full_player_next"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/spacing_xl"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Queue Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_full_player_queue"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height"
        android:text="@string/queue_empty"
        android:icon="@drawable/ic_queue"
        app:iconGravity="start"
        app:iconPadding="@dimen/spacing_xs"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/slider_full_player_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_lg"
        android:layout_marginHorizontal="@dimen/margin_screen_edge"
        style="@style/Widget.EqnityMusic.Button.Outlined" />
</androidx.constraintlayout.widget.ConstraintLayout>