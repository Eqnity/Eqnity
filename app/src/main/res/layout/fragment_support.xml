<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_primary"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/support_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/support_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface_primary"
            app:title="@string/support_title"
            app:titleTextAppearance="@style/TextAppearance.EqnityMusic.TitleLarge"
            app:contentInsetStart="@dimen/margin_screen_edge"
            app:contentInsetEnd="@dimen/margin_screen_edge" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/player_height_collapsed"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_screen_edge">

            <!-- App Logo -->
            <ImageView
                android:id="@+id/support_app_logo"
                android:layout_width="@dimen/avatar_size_xxl"
                android:layout_height="@dimen/avatar_size_xxl"
                android:scaleType="centerCrop"
                android:contentDescription="@string/app_name"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- App Name & Version -->
            <TextView
                android:id="@+id/support_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.EqnityMusic.HeadlineMedium"
                android:textColor="@color/text_primary"
                app:layout_constraintTop_toBottomOf="@id/support_app_logo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_lg" />

            <TextView
                android:id="@+id/support_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/support_version"
                android:textAppearance="@style/TextAppearance.EqnityMusic.BodyMedium"
                android:textColor="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/support_app_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_xxs" />

            <!-- Divider -->
            <View
                android:id="@+id/support_divider_1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                app:layout_constraintTop_toBottomOf="@id/support_app_version"
                android:layout_marginTop="@dimen/spacing_xl"
                android:layout_marginHorizontal="@dimen/margin_screen_edge" />

            <!-- About Eqnity Section -->
            <TextView
                android:id="@+id/support_section_about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/support_section_about"
                android:textAppearance="@style/TextAppearance.EqnityMusic.TitleMedium"
                android:textColor="@color/text_primary"
                app:layout_constraintTop_toBottomOf="@id/support_divider_1"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="@dimen/spacing_lg" />

            <TextView
                android:id="@+id/support_about_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EqnityMusic.BodyMedium"
                android:textColor="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/support_section_about"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_md" />

            <!-- What I Do Section -->
            <TextView
                android:id="@+id/support_section_skills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/support_section_skills"
                android:textAppearance="@style/TextAppearance.EqnityMusic.TitleMedium"
                android:textColor="@color/text_primary"
                app:layout_constraintTop_toBottomOf="@id/support_about_content"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="@dimen/spacing_xl" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_skills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/support_section_skills"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_md" />

            <!-- Divider -->
            <View
                android:id="@+id/support_divider_2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                app:layout_constraintTop_toBottomOf="@id/rv_skills"
                android:layout_marginTop="@dimen/spacing_xl"
                android:layout_marginHorizontal="@dimen/margin_screen_edge" />

            <!-- Contact Section -->
            <TextView
                android:id="@+id/support_section_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/support_section_contact"
                android:textAppearance="@style/TextAppearance.EqnityMusic.TitleMedium"
                android:textColor="@color/text_primary"
                app:layout_constraintTop_toBottomOf="@id/support_divider_2"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="@dimen/spacing_lg" />

            <!-- GitHub Contact -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/contact_github_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/card_corner_radius_small"
                app:cardBackgroundColor="@color/surface_secondary"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/support_section_contact"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:id="@+id/contact_github_icon"
                        android:layout_width="@dimen/icon_size_lg"
                        android:layout_height="@dimen/icon_size_lg"
                        android:src="@drawable/ic_github"
                        android:tint="@color/accent_primary"
                        android:contentDescription="@string/support_github"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/contact_github_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/support_contact_github"
                        android:textAppearance="@style/TextAppearance.EqnityMusic.BodyLarge"
                        android:textColor="@color/text_primary"
                        app:layout_constraintStart_toEndOf="@id/contact_github_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_marginEnd="@dimen/spacing_md" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Discord Contact -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/contact_discord_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/card_corner_radius_small"
                app:cardBackgroundColor="@color/surface_secondary"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/contact_github_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:id="@+id/contact_discord_icon"
                        android:layout_width="@dimen/icon_size_lg"
                        android:layout_height="@dimen/icon_size_lg"
                        android:src="@drawable/ic_discord"
                        android:tint="@color/accent_secondary"
                        android:contentDescription="@string/support_discord"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/contact_discord_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/support_contact_discord"
                        android:textAppearance="@style/TextAppearance.EqnityMusic.BodyLarge"
                        android:textColor="@color/text_primary"
                        app:layout_constraintStart_toEndOf="@id/contact_discord_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_marginEnd="@dimen/spacing_md" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Loading State -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/support_loading_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:padding="@dimen/spacing_xl"
                app:layout_constraintTop_toBottomOf="@id/support_app_version"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/support_loading_progress"
                    android:layout_width="@dimen/circular_progress_size"
                    android:layout_height="@dimen/circular_progress_size"
                    android:indeterminate="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:indicatorColor="@color/accent_primary" />

                <TextView
                    android:id="@+id/support_loading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/support_loading"
                    android:textAppearance="@style/TextAppearance.EqnityMusic.BodyMedium"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintTop_toBottomOf="@id/support_loading_progress"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="@dimen/spacing_md" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Error State -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/support_error_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:padding="@dimen/spacing_xl"
                app:layout_constraintTop_toBottomOf="@id/support_app_version"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/support_error_icon"
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:src="@drawable/ic_error"
                    android:tint="@color/error"
                    android:contentDescription="@string/support_error"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/support_error_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/support_error"
                    android:textAppearance="@style/TextAppearance.EqnityMusic.TitleMedium"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/support_error_icon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="@dimen/spacing_md" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_retry_support"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:text="@string/support_retry"
                    app:layout_constraintTop_toBottomOf="@id/support_error_text"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="@dimen/spacing_lg"
                    style="@style/Widget.EqnityMusic.Button" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>