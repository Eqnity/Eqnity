<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:android="http://schemas.android.com/apk/res/android">
    <cloud-backup>
        <include domain="database" path="eqnity_music.db" />
        <include domain="sharedpref" path="eqnity_music_prefs.xml" />
        <exclude domain="file" path="cache/" />
        <exclude domain="file" path="Music/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="eqnity_music.db" />
        <include domain="sharedpref" path="eqnity_music_prefs.xml" />
        <exclude domain="file" path="cache/" />
        <exclude domain="file" path="Music/" />
    </device-transfer>
</data-extraction-rules>