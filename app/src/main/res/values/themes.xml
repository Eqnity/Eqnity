<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme - Dark Only -->
    <style name="Theme.EqnityMusic" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary Brand Colors (10% Accent) -->
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryVariant">@color/accent_primary_variant</item>
        <item name="colorPrimaryContainer">@color/accent_primary_container</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Secondary Brand Colors -->
        <item name="colorSecondary">@color/accent_secondary</item>
        <item name="colorSecondaryVariant">@color/accent_secondary_variant</item>
        <item name="colorSecondaryContainer">@color/accent_secondary_container</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>

        <!-- Surface Colors (60% Primary, 30% Secondary) -->
        <item name="colorSurface">@color/surface_primary</item>
        <item name="colorSurfaceVariant">@color/surface_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Background - use framework attribute (MaterialComponents 1.12 doesn't have Material3 color attrs) -->
        <item name="android:colorBackground">@color/surface_primary</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnError">@color/text_on_accent</item>
        <item name="colorOnErrorContainer">@color/text_primary</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Elevation Overlay (for dark theme surface elevation) -->
        <item name="elevationOverlayEnabled">true</item>
        <item name="elevationOverlayColor">@color/white</item>
        <item name="elevationOverlayAccentColor">@color/accent_primary</item>

        <!-- Typography - Use system fonts -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.EqnityMusic.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.EqnityMusic.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.EqnityMusic.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.EqnityMusic.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.EqnityMusic.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.EqnityMusic.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.EqnityMusic.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.EqnityMusic.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.EqnityMusic.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.EqnityMusic.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.EqnityMusic.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.EqnityMusic.LabelSmall</item>

        <!-- Shape Appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.EqnityMusic.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.EqnityMusic.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.EqnityMusic.LargeComponent</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.EqnityMusic.CornerSmall</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.EqnityMusic.CornerMedium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.EqnityMusic.CornerLarge</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/surface_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@color/surface_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Ripple -->
        <item name="colorControlHighlight">@color/accent_primary_container</item>

        <!-- Divider -->
        <item name="android:divider">@color/divider</item>
        <item name="android:dividerHeight">1dp</item>

        <!-- Force dark theme -->
        <item name="android:forceDarkAllowed">true</item>

        <!-- Material Components Overrides - minimal set -->
        <item name="materialButtonStyle">@style/Widget.EqnityMusic.Button</item>
        <item name="textInputStyle">@style/Widget.EqnityMusic.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.EqnityMusic.Chip</item>
        <item name="bottomNavigationStyle">@style/Widget.EqnityMusic.BottomNavigationView</item>
        <item name="floatingActionButtonStyle">@style/Widget.EqnityMusic.FloatingActionButton</item>
        <item name="cardViewStyle">@style/Widget.EqnityMusic.CardView</item>
        <item name="sliderStyle">@style/Widget.EqnityMusic.Slider</item>
        <item name="switchStyle">@style/Widget.EqnityMusic.Switch</item>
        <item name="checkboxStyle">@style/Widget.EqnityMusic.CheckBox</item>
        <item name="radioButtonStyle">@style/Widget.EqnityMusic.RadioButton</item>
        <item name="snackbarStyle">@style/Widget.EqnityMusic.Snackbar</item>
        <item name="toolbarStyle">@style/Widget.EqnityMusic.Toolbar</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.EqnityMusic.Splash" parent="Theme.EqnityMusic">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Bottom Sheet Dialog Theme -->
    <style name="Theme.EqnityMusic.BottomSheetDialog" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.EqnityMusic.BottomSheet</item>
        <item name="colorSurface">@color/surface_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <!-- Typography Styles - Use system fonts (no custom font files needed) -->
    <style name="TextAppearance.EqnityMusic.HeadlineLarge" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">32sp</item>
        <item name="android:fontWeight">700</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EqnityMusic.HeadlineMedium" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">28sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EqnityMusic.HeadlineSmall" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">24sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EqnityMusic.TitleLarge" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">22sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EqnityMusic.TitleMedium" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">16sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EqnityMusic.TitleSmall" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">14sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EqnityMusic.BodyLarge" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:fontWeight">400</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EqnityMusic.BodyMedium" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:fontWeight">400</item>
        <item name="android:letterSpacing">0.025</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.EqnityMusic.BodySmall" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontWeight">400</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.EqnityMusic.LabelLarge" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:fontWeight">500</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EqnityMusic.LabelMedium" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontWeight">500</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.EqnityMusic.LabelSmall" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:fontWeight">500</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Shape Appearance - Use MaterialComponents parents -->
    <style name="ShapeAppearance.EqnityMusic.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.EqnityMusic.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.EqnityMusic.LargeComponent" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.EqnityMusic.CornerSmall" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="ShapeAppearance.EqnityMusic.CornerMedium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.EqnityMusic.CornerLarge" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Widget Styles -->
    <style name="Widget.EqnityMusic.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="backgroundTint">@color/accent_primary</item>
        <item name="rippleColor">@color/accent_primary_variant</item>
    </style>

    <style name="Widget.EqnityMusic.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="strokeColor">@color/accent_primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="rippleColor">@color/accent_primary_container</item>
    </style>

    <style name="Widget.EqnityMusic.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_secondary</item>
        <item name="boxStrokeColor">@color/outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="placeholderTextColor">@color/text_tertiary</item>
        <item name="hintTextColor">@color/text_tertiary</item>
        <item name="counterTextColor">@color/text_tertiary</item>
        <item name="errorTextColor">@color/error</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <style name="Widget.EqnityMusic.Chip" parent="Widget.MaterialComponents.Chip.Entry">
        <item name="chipBackgroundColor">@color/surface_secondary</item>
        <item name="chipStrokeColor">@color/outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="closeIconTint">@color/text_tertiary</item>
    </style>

    <style name="Widget.EqnityMusic.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/tab_background</item>
        <item name="itemIconTint">@color/bottom_nav_item_tint</item>
        <item name="itemTextColor">@color/bottom_nav_item_tint</item>
        <item name="itemRippleColor">@color/accent_primary_container</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.EqnityMusic.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/accent_primary</item>
        <item name="rippleColor">@color/accent_primary_variant</item>
        <item name="tint">@color/text_on_accent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.EqnityMusic.LargeComponent</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="Widget.EqnityMusic.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_secondary</item>
        <item name="cardElevation">2dp</item>
        <item name="cardMaxElevation">8dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.EqnityMusic.Slider" parent="Widget.MaterialComponents.Slider">
        <item name="trackColor">@color/progress_inactive</item>
        <item name="trackColorActive">@color/progress_active</item>
        <item name="thumbColor">@color/accent_primary</item>
        <item name="haloColor">@color/accent_primary_container</item>
        <item name="tickColor">@color/outline</item>
        <item name="tickColorActive">@color/accent_primary</item>
        <item name="trackHeight">4dp</item>
        <item name="thumbRadius">12dp</item>
    </style>

    <style name="Widget.EqnityMusic.SeekBar" parent="Widget.MaterialComponents.Slider">
        <item name="trackColor">@color/progress_inactive</item>
        <item name="trackColorActive">@color/progress_active</item>
        <item name="thumbColor">@color/accent_primary</item>
        <item name="haloColor">@color/accent_primary_container</item>
        <item name="trackHeight">4dp</item>
        <item name="thumbRadius">10dp</item>
    </style>

    <style name="Widget.EqnityMusic.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbColor">@color/switch_thumb_color</item>
        <item name="trackColor">@color/switch_track_color</item>
        <item name="android:minHeight">32dp</item>
    </style>

    <style name="Widget.EqnityMusic.CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="buttonTint">@color/checkbox_button_tint</item>
        <item name="android:minHeight">24dp</item>
        <item name="android:minWidth">24dp</item>
    </style>

    <style name="Widget.EqnityMusic.RadioButton" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="buttonTint">@color/radio_button_tint</item>
        <item name="android:minHeight">24dp</item>
        <item name="android:minWidth">24dp</item>
    </style>

    <style name="Widget.EqnityMusic.ProgressBar" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminateTint">@color/accent_primary</item>
    </style>

    <style name="Widget.EqnityMusic.CircularProgressIndicator" parent="Widget.MaterialComponents.CircularProgressIndicator">
        <item name="indicatorColor">@color/accent_primary</item>
        <item name="trackColor">@color/progress_inactive</item>
        <item name="trackThickness">4dp</item>
        <item name="indicatorSize">48dp</item>
    </style>

    <style name="Widget.EqnityMusic.LinearProgressIndicator" parent="Widget.MaterialComponents.LinearProgressIndicator">
        <item name="indicatorColor">@color/accent_primary</item>
        <item name="trackColor">@color/progress_inactive</item>
        <item name="trackThickness">4dp</item>
        <item name="trackCornerRadius">2dp</item>
    </style>

    <style name="Widget.EqnityMusic.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="backgroundTint">@color/surface_secondary_elevated</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.EqnityMusic.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.EqnityMusic.LargeComponent</item>
        <item name="backgroundTint">@color/surface_secondary</item>
    </style>

    <style name="Widget.EqnityMusic.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.EqnityMusic.TitleLarge</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.EqnityMusic.BodyMedium</item>
        <item name="navigationIconTint">@color/text_primary</item>
        <item name="background">@color/surface_primary</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Player specific styles -->
    <style name="Widget.EqnityMusic.PlayerControls" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Widget.EqnityMusic.PlayerControlButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">@color/text_primary</item>
        <item name="rippleColor">@color/accent_primary_container</item>
    </style>

    <style name="Widget.EqnityMusic.PlayerControlButton.PlayPause" parent="Widget.EqnityMusic.PlayerControlButton">
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:padding">16dp</item>
        <item name="backgroundTint">@color/accent_primary</item>
        <item name="android:tint">@color/text_on_accent</item>
        <item name="rippleColor">@color/accent_primary_variant</item>
    </style>

    <!-- Download item styles -->
    <style name="Widget.EqnityMusic.DownloadItem" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_secondary</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Playlist item styles -->
    <style name="Widget.EqnityMusic.PlaylistItem" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_secondary</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>